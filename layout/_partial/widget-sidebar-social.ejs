<div class="social mv2">
  <h4>Let's Keep in Touch</h4>
  <% ['pinterest', 'facebook', 'twitter'].forEach(function(name) {
    var platform = theme.social_platforms && theme.social_platforms[name];
    if (!platform) return; %>
    <a class="link dib h2 w2 mr3 grow" href="<%= platform.url %>" title="<%= platform.title %>" target="_blank" rel="noopener nofollow" style="width: 32px; display: inline-block;">
      <%- platform.svg %>
    </a>
  <% }); %>
</div>
